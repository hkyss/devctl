{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devctl/devctl/schemas/devctl.profile.schema.json",
  "title": "devctl project profile",
  "description": "Contract for .devctl.json at the root of an application repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "adapter"],
  "allOf": [
    { "oneOf": [{ "required": ["compose_file"] }, { "required": ["compose_files"] }] },
    { "oneOf": [{ "required": ["http_port_env"] }, { "required": ["publish"] }] }
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable project id used by devctl up <name> and the default local domain."
    },
    "adapter": {
      "type": "string",
      "const": "docker-compose"
    },
    "compose_file": {
      "type": "string",
      "minLength": 1
    },
    "compose_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "http_port_env": {
      "type": "string",
      "minLength": 1
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "container_port"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "container_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "compose_override": {
      "type": "object",
      "description": "Inline Compose fragment rendered into the generated override file (extra services, networks, volumes).",
      "properties": {
        "services": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "env_file": {
      "type": "string",
      "minLength": 1
    },
    "extra_port_envs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preferred_ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "host_prefixed_port_envs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "publish_envs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "host": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pre_up_commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "boolean"
    },
    "health_timeout_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "health_check_path": {
      "type": "string",
      "minLength": 1
    },
    "health_check_statuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 100,
        "maximum": 599
      }
    },
    "compose_project_name": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "primary_service": {
      "type": "string",
      "minLength": 1,
      "description": "Compose service used by `devctl exec` when --service is not given."
    },
    "extra_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "port_env"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "port_env": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
