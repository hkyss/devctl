{
  "name": "example-rails",
  "adapter": "docker-compose",
  "compose_file": "docker-compose.yml",
  "env_file": ".env",
  "http_port_env": "PORT_HTTP",
  "extra_port_envs": ["PORT_DB"],
  "preferred_ports": [3000, 5432],
  "host_prefixed_port_envs": ["PORT_HTTP"],
  "env": {
    "PROJECT_NAME": "devctl_example_rails"
  },
  "pre_up_commands": [
    ["web", "bundle", "install"]
  ],
  "build": true,
  "health_timeout_seconds": 120,
  "health_check_path": "/",
  "health_check_statuses": [200, 302]
}
